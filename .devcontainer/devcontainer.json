{
  "name": "ARD Audiothek RSS Adapter",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": ["--init"],
  "forwardPorts": [8411],
  "portsAttributes": {
    "8411": {
      "label": "Ktor Server"
    }
  },
  "postCreateCommand": "mvn -version",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JDK 21",
            "path": "/usr/lib/jvm/java-21-openjdk-amd64",
            "default": true
          }
        ],
        "kotlin.compiler.languageVersion": "2.0"
      }
    }
  }
}
